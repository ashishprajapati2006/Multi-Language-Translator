# Server Port (Render sets this automatically)
PORT=5000

# CORS Allowed Origin (set to your Vercel URL e.g. https://your-translator.vercel.app or * for all)
FRONTEND_URL=*

# Hugging Face Model Repository
HF_MODEL_REPO=ashishprajapati2006/translator-model

# Optional Hugging Face Hub Access Token (needed only if repository is private)
HUGGINGFACE_HUB_TOKEN=

# Pre-load models in background on startup (true/false)
WARMUP_ON_START=false
